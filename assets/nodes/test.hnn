IP 127.0.0.1
NAME Test PC
TYPE DESKTOP
PORTS 6
PORTNAMES SSH SQL HTTP SSL SMTP FTP
PORTNUMBERS 22 1433 80 443 25 21
PROXY TRUE
FIREWALL TRUE
USER admin
PASSWD zxcvbn
ADMINKEEP TRUE
FILESYSTEM
    FOLDER home
        FOLDER misc
        END_FOLDER
    END_FOLDER
    FOLDER log
        FILE [CONNECTED]TEST
        END_FILE
    END_FOLDER
    FOLDER bin
        FILE SecurityTracer.exe
        END_FILE
    END_FOLDER
    FOLDER sys
        FILE os-config.sys
        END_FILE
        FILE bootcfg.dll
        END_FILE
        FILE netcfgx.dll
        END_FILE
        FILE x-server.sys
        END_FILE
    END_FOLDER
    FOLDER test
        FOLDER 1
        END_FOLDER
        FOLDER 2
        END_FOLDER
    END_FOLDER
END_FILESYSTEM
SCANIP 0
TRACE 60