IP ${PLAYERIP}
NAME ${PLAYERNAME}'s PC
TYPE DESKTOP
PORTS 6
PORTNAMES SSH SQL HTTP SSL SMTP FTP
PORTNUMBERS 22 1433 80 443 25 21
PROXY TRUE
FIREWALL TRUE
USER admin
PASSWD zxcvbn
ADMINKEEP TRUE
FILESYSTEM
  FOLDER home
    FOLDER misc
    END_FOLDER
  END_FOLDER
  FOLDER bin
    FILE SecurityTracer.exe
    END_FILE
  END_FOLDER
  FOLDER log
  END_FOLDER
END_FILESYSTEM
SCANIP 0
TRACE 60