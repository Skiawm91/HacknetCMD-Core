BEGIN_VT100COLORWARN_EN
PRINT
PRINT  // WARNING //
PRINT  If VT100 Color Support is disabled,
PRINT  color accuracy will drop significantly.
PRINT  ______________________________
PRINT  | | Confirm                  |
PRINT  ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
PRINT  ______________________________
PRINT  | | Cancel                   |
PRINT  ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
END_VT100COLORWARN_EN

BEGIN_VT100COLORWARN_CHS
PRINT
PRINT  // 警告 //
PRINT  若 VT100 色彩支持被关闭，
PRINT  颜色准确率将会大幅下降。
PRINT  ______________________________
PRINT  | | 重复                     |
PRINT  ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
PRINT  ______________________________
PRINT  | | 取消                     |
PRINT  ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
END_VT100COLORWARN_CHS

BEGIN_VT100COLORWARN_CHT
PRINT
PRINT  // 警告 //
PRINT  若 VT100 色彩支援被關閉，
PRINT  顏色準確度將會大幅下降。
PRINT  ______________________________
PRINT  | | 確認                     |
PRINT  ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
PRINT  ______________________________
PRINT  | | 取消                     |
PRINT  ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
END_VT100COLORWARN_CHT

