{
    "version": 4,
    "configurations": [
        {
            "name": "C++ IntelliSense",
            "intelliSenseMode": "windows-msvc-x64",
            "cppStandard": "c++20",
            "cStandard": "c17",
            "includePath": [
                "${workspaceFolder}/source",
                "${workspaceFolder}/interface",
                "${workspaceFolder}/**"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/source",
                    "${workspaceFolder}/interface"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            },
            "defines": []
        }
    ]
}