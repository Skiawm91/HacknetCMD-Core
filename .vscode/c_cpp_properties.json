{
    "version": 4,
    "configurations": [
        {
            "name": "C++ IntelliSense",
            "intelliSenseMode": "windows-msvc-x64",
            "cppStandard": "c++20",
            "cStandard": "c17",
            "includePath": [
                "${workspaceFolder}/source",      // cppm 來源
                "${workspaceFolder}/interface",   // 預編譯 IFC
                "${workspaceFolder}/**"           // 遞迴其他子資料夾
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/source",
                    "${workspaceFolder}/interface"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            },
            "defines": []
        }
    ]
}